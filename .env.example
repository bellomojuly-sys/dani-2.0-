# Copy to .env and fill in. .env is ignored by git; never commit real values.
DEEPSEEK_API_KEY=your-key-here
# Notion internal integration token (Settings → Connections), shared with the Tasks database only.
NOTION_TOKEN=your-notion-integration-token
# The Tasks database id (the 32-hex part of its URL).
NOTION_TASKS_DB_ID=your-tasks-database-id
# One or more calendar addresses, comma-separated: Google Calendar "Secret address in iCal format" (Settings → calendar → Integrate calendar), or a webcal:// subscription link from another app (Eitje, a timetable).
GCAL_ICS_URL=https://calendar.google.com/calendar/ical/.../private-.../basic.ics,https://...
# Optional. Whisper for voice input in the chat (a second provider, OpenAI). Without it the browser dictation is used.
OPENAI_API_KEY=
# Required only to open the dashboard to the phone (python server.py --host 0.0.0.0): the page asks for it once.
DANI_PIN=
# Optional. Path of the Google service-account key file (JSON, kept outside the repository). With it the calendars shared with that account are read and written through the Calendar API.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional (D2-056). The Projects & Goals database id: with it the chat can read projects and 1/3/10-year goals. Share the database with the integration.
NOTION_PROJECTS_DB_ID=
# Optional (D2-056). The pages the chat may read, as name=page_id separated by ";" (life plan, area pages, project roadmaps). Only these, and each must be shared with the integration.
NOTION_PAGES=piano di vita=...;Betsy roadmap=...
# Optional (D2-057). The "Dani — consumo token" database id: token totals are saved there and survive a restart. Without it they are kept in memory only.
NOTION_USAGE_DB_ID=
# Optional (D2-058). The Notion page "Dani — chi sono e come pianifico": who she is, goals, projects, rules. Always in the chat prompt.
NOTION_CONTEXT_PAGE_ID=
