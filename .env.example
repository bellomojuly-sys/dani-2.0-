# Copy to .env and fill in. .env is ignored by git; never commit real values.
DEEPSEEK_API_KEY=your-key-here
# Notion internal integration token (Settings → Connections), shared with the Tasks database only.
NOTION_TOKEN=your-notion-integration-token
# The Tasks database id (the 32-hex part of its URL).
NOTION_TASKS_DB_ID=your-tasks-database-id
# One or more Google Calendar "Secret address in iCal format" (Settings → calendar → Integrate calendar), comma-separated.
GCAL_ICS_URL=https://calendar.google.com/calendar/ical/.../private-.../basic.ics,https://...
# Optional. Whisper for voice input in the chat (a second provider, OpenAI). Without it the browser dictation is used.
OPENAI_API_KEY=
# Required only to open the dashboard to the phone (python server.py --host 0.0.0.0): the page asks for it once.
DANI_PIN=
# Optional. Path of the Google service-account key file (JSON, kept outside the repository). With it the calendars shared with that account are read and written through the Calendar API.
GOOGLE_SERVICE_ACCOUNT_FILE=
